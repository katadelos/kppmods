find_package(Python3 REQUIRED COMPONENTS Interpreter)
if(KPPMODS_BUILD_UI)
    find_program(NODE_EXECUTABLE node REQUIRED)
endif()
set(KPPMODS_ARCHITECTURE "" CACHE STRING "Extension ARM ABI: kindlehf or kindlepw2")
set(KPPMODS_EXCLUDE_EXTENSIONS "" CACHE STRING
    "Bundled extensions to exclude (semicolon-separated directory names)")
if(NOT KPPMODS_ARCHITECTURE MATCHES "^(kindlehf|kindlepw2)$")
    message(FATAL_ERROR "Set KPPMODS_ARCHITECTURE to kindlehf or kindlepw2, or use a preset")
endif()
file(READ "${PROJECT_SOURCE_DIR}/release.json" release)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/release.json")
string(JSON count LENGTH "${release}" extensions)
if(count EQUAL 0)
    return()
endif()
math(EXPR last "${count} - 1")
if(KPPMODS_BUILD_UI)
    file(GLOB_RECURSE ui_sources CONFIGURE_DEPENDS
        "${PROJECT_SOURCE_DIR}/ui/*" "${PROJECT_SOURCE_DIR}/tools/build/*.cjs"
        "${PROJECT_SOURCE_DIR}/vendor/react-kindle/packages/react-kindle/src/*")
    set(toolkit "${CMAKE_BINARY_DIR}/ui/toolkit.js")
    add_custom_command(OUTPUT "${toolkit}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/ui"
        COMMAND ${NODE_EXECUTABLE} "${PROJECT_SOURCE_DIR}/tools/build/build-toolkit.cjs" "${toolkit}"
        DEPENDS ${ui_sources} "${PROJECT_SOURCE_DIR}/package-lock.json"
        WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" VERBATIM)
    add_custom_target(kppmods-toolkit DEPENDS "${toolkit}")
endif()
foreach(index RANGE ${last})
    string(JSON name GET "${release}" extensions ${index})
    if(name IN_LIST KPPMODS_EXCLUDE_EXTENSIONS)
        continue()
    endif()
    set(source "${PROJECT_SOURCE_DIR}/extensions/${name}")
    file(READ "${source}/manifest.json" manifest)
    string(JSON id GET "${manifest}" id)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}/manifest.json")
    string(JSON ui_count ERROR_VARIABLE no_ui LENGTH "${manifest}" ui)
    string(JSON runtime ERROR_VARIABLE no_runtime GET "${manifest}" ui_runtime)
    set(has_ui OFF)
    if((NOT no_ui AND ui_count GREATER 0) OR NOT no_runtime)
        set(has_ui ON)
    endif()
    if(has_ui AND NOT KPPMODS_BUILD_UI)
        continue()
    endif()
    set(native_targets "")
    if(EXISTS "${source}/native/CMakeLists.txt")
        add_subdirectory("${source}/native" "${CMAKE_BINARY_DIR}/extensions/${name}/native")
        get_property(native_targets DIRECTORY "${source}/native" PROPERTY BUILDSYSTEM_TARGETS)
        add_dependencies(kppmods-native ${native_targets})
    endif()
    list(APPEND extension_ids "${id}")
    list(APPEND manifests "${source}/manifest.json")
    file(GLOB_RECURSE inputs CONFIGURE_DEPENDS "${source}/*")
    string(JOIN "\n" input_list ${inputs})
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/extension-${name}.inputs" CONTENT "${input_list}\n")
    set(payload "${CMAKE_BINARY_DIR}/staging/${name}")
    set(ui_dependencies "")
    if(has_ui)
        set(ui_dependencies kppmods-toolkit "${toolkit}")
    endif()
    add_custom_command(OUTPUT "${payload}/manifest.json"
        COMMAND ${CMAKE_COMMAND} -E rm -rf "${payload}"
        COMMAND ${Python3_EXECUTABLE} "${PROJECT_SOURCE_DIR}/tools/packaging/package.py"
            "${name}" "${payload}"
            --toolkit "${toolkit}" --architecture "${KPPMODS_ARCHITECTURE}"
        DEPENDS ${inputs} ${ui_dependencies}
            "${CMAKE_BINARY_DIR}/extension-${name}.inputs" "${CMAKE_CURRENT_LIST_FILE}"
            "${PROJECT_SOURCE_DIR}/tools/packaging/package.py" "${PROJECT_SOURCE_DIR}/release.json"
        WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}" VERBATIM)
    add_custom_target(kppmods-extension-${name} ALL DEPENDS "${payload}/manifest.json")
    install(DIRECTORY "${payload}/" DESTINATION "usr/lib/kppmods/extensions/${id}"
        USE_SOURCE_PERMISSIONS COMPONENT extension-${name})
    if(native_targets)
        add_dependencies(kppmods-extension-${name} ${native_targets})
        install(TARGETS ${native_targets} LIBRARY DESTINATION "usr/lib/kppmods/extensions/${id}/lib"
            COMPONENT extension-${name})
    endif()
endforeach()
foreach(path IN LISTS manifests)
    file(READ "${path}" manifest)
    string(JSON needs ERROR_VARIABLE error GET "${manifest}" needs)
    if(NOT error)
        string(JSON count LENGTH "${needs}")
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE ${last})
                string(JSON dependency GET "${needs}" ${index})
                if(NOT dependency IN_LIST extension_ids)
                    message(FATAL_ERROR "${path} requires unselected extension ${dependency}")
                endif()
            endforeach()
        endif()
    endif()
endforeach()
