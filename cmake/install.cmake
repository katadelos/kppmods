install(TARGETS kppmods-runtime RUNTIME DESTINATION usr/bin COMPONENT core)
foreach(abi RANGE 0 1)
    install(TARGETS kppmods-host-${abi} LIBRARY DESTINATION usr/lib/kppmods/abi${abi} COMPONENT core)
endforeach()
install(TARGETS kppmods-framework-exec LIBRARY DESTINATION usr/lib/kppmods COMPONENT core)
install(PROGRAMS packaging/opkg/kppmods-start DESTINATION usr/bin COMPONENT core)
install(FILES packaging/opkg/upstart/kppmods.conf packaging/opkg/upstart/kppmods-storage.conf
    DESTINATION usr/share/kppmods/upstart COMPONENT core)
install(PROGRAMS packaging/opkg/kppmods-mntus DESTINATION usr/share/kppmods COMPONENT core)
foreach(dependency IN ITEMS boost utfcpp openlipc hermes-dec)
    if(dependency STREQUAL "boost")
        set(license LICENSE_1_0.txt)
    elseif(dependency STREQUAL "openlipc")
        set(license LICENSE.txt)
    else()
        set(license LICENSE)
    endif()
    install(FILES "vendor/${dependency}/${license}"
        DESTINATION usr/share/licenses/kppmods RENAME "${dependency}.txt" COMPONENT core)
endforeach()

install(PROGRAMS packaging/opkg/kppmods.sh DESTINATION usr/share/kppmods COMPONENT core)
